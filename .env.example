# Local CLI model adapters (no API key — uses your existing CLI login).
# Leave unset to fall back to `codex` / `claude` on PATH.
CODEX_CLI_PATH=/Applications/Codex.app/Contents/Resources/codex
CLAUDE_CLI_PATH=/Users/you/.local/bin/claude
# Google Gemini CLI (non-interactive `gemini -p`). Uses your local Gemini login.
GEMINI_CLI_PATH=/opt/homebrew/bin/gemini

# How long to wait for a local CLI generation before timing out (ms). Raise this
# if distilling long transcripts times out. Default 300000 (5 min).
# LOCAL_AI_TIMEOUT_MS=300000

# Max characters of source text sent to a single distill run (the raw snapshot is
# never truncated). Default 60000. Lower it for faster/cheaper distills.
# DISTILL_MAX_CHARS=60000

# Rate-limit resilience for large batches.
# Model retry/backoff on 429/quota/overload errors:
# MODEL_RETRY_MAX=4            # max retries per model call
# MODEL_RETRY_BASE_MS=2000     # backoff base (exponential + jitter, capped 30s)
# Gap the queue waits between jobs, per provider (ms):
# THROTTLE_LOCAL_MS=500        # claude / codex CLI
# THROTTLE_GEMINI_CLI_MS=3000  # free Gemini CLI is the most rate-limited
# THROTTLE_API_MS=1500         # openai / gemini API
# Queue journal location (resumes a batch after restart; default ./data/queue.json):
# PROJECTFORGE_QUEUE=./data/queue.json

# Cloud API model adapters (optional — only needed for openai:* / gemini:* models).
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Override the local SQLite index location (defaults to ./data/projectforge.sqlite).
# PROJECTFORGE_DB=./data/projectforge.sqlite
